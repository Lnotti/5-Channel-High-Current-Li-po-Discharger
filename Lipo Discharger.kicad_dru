(version 1)
(rule via_to_pad_same_net
    (constraint physical_hole_clearance (min 0.2mm))
    (condition "A.Type == 'via' && B.Type == 'pad'"))
(rule "Clearance: THT Pad to SMD Pad 2.03mm"
    (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Pad_Type == 'Through-hole' && B.Pad_Type == 'SMD' && A.Parent != B.Parent")
    (constraint clearance (min 2.03mm))
    (constraint physical_clearance (min 2.03mm))
)

